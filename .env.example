# 이 파일을 .env 로 복사해서 쓰거나, 그냥 셸에 export 해도 됩니다.
# 값을 지정하지 않으면 agent.py에 하드코딩된 값이 쓰입니다.

# Bedrock 리전 (서울)
BEDROCK_REGION=ap-northeast-2

# 모델 ID — 발표장 계정이 달라서 액세스가 없을 때만 바꾸세요.
# 확인: aws bedrock list-inference-profiles --region ap-northeast-2
# 폴백(더 싸고 빠름): global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# 터미널 색을 끄고 싶으면
# NO_COLOR=1
